# --- Database (Postgres on the VPS) ---
# A database Payload owns by itself (NOT the old Prisma one — table names collide).
# Local development uses the same production database (there is no local one).
DATABASE_URI=postgresql://<user>:<password>@127.0.0.1:5433/<payload-db>

# --- Payload ---
# Long random string (`openssl rand -hex 32`). Changing it logs every admin out.
PAYLOAD_SECRET=

# Public URL of the site, no trailing slash (CORS/CSRF, admin links).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Media storage (Garage S3) — required ---
S3_ENDPOINT=https://s3-<node>.<domain>
S3_REGION=garage
S3_BUCKET=<bucket>
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# The bucket's public *web* endpoint (not the S3 API host). Uploaded image URLs
# are built from it and next.config.ts allows it for next/image.
NEXT_PUBLIC_ASSET_BASE_URL=https://<bucket>.web-<node>.<domain>

# --- One-off legacy import only (npm run migrate:legacy) ---
# The old Express/Prisma database. Only read from.
LEGACY_DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:5433/<old-db>
