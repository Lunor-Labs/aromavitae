generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           String    @id @default(cuid())
  name         String
  price        Int                          // whole units of `currency` (e.g. 1450 LKR)
  currency     String    @default("LKR")
  rating       Float
  reviewCount  Int       @map("review_count")
  image        String
  sideImages   String[]  @default([]) @map("side_images")
  description  String?
  badge        String?
  isBestSeller Boolean   @default(false) @map("is_best_seller")
  categoryId   String?   @map("category_id")
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([categoryId])
  @@map("products")
}

model Category {
  id        String    @id @default(cuid())
  name      String
  image     String
  href      String
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@map("categories")
}

model GalleryImage {
  id        String   @id @default(cuid())
  image     String
  alt       String   @default("")
  tags      String[] @default([])
  span      String?                        // 'tall' | 'wide' | null (masonry sizing)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("gallery_images")
}

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  author    String
  location  String
  rating    Int
  imageA    String?  @map("image_a")
  imageB    String?  @map("image_b")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("testimonials")
}

model Outlet {
  id          String   @id @default(cuid())
  name        String
  address     String
  phone       String
  description String
  image       String
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("outlets")
}

// Hero, Story, Navbar, Footer, AnnouncementBar, GiftSetsBanner each stored as one row
model Singleton {
  key       String   @id                   // 'hero' | 'story' | 'navbar' | 'footer' | 'announcement' | 'giftSetsBanner'
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("singletons")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}
